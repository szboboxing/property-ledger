@page "/reports"
@attribute [Authorize(Policy = "Feature:reports")]
@rendermode InteractiveServer
@inject AppDbContext Db

<PageTitle>报表</PageTitle>

<div class="page-head">
    <h1>报表</h1>
    <select class="form-select w-auto" @bind="yearFilter">
        <option value="0">全部年份</option>
        @foreach (var y in years)
        {
            <option value="@y">@y 年</option>
        }
    </select>
</div>

@if (all.Count == 0)
{
    <div class="card p-4 empty">还没有账单数据。签订租约并出账后，这里会汇总展示应收 / 已收 / 未收情况。</div>
}
else
{
    <div class="stat-grid">
        <div class="stat">
            <div class="label">应收合计</div>
            <div class="value">¥@sumTotal.ToString("0.00")</div>
        </div>
        <div class="stat">
            <div class="label">已收合计</div>
            <div class="value ok">¥@sumPaid.ToString("0.00")</div>
        </div>
        <div class="stat">
            <div class="label">未收合计</div>
            <div class="value danger">¥@sumDue.ToString("0.00")</div>
        </div>
        <div class="stat">
            <div class="label">收款率</div>
            <div class="value">@Rate</div>
        </div>
    </div>

    <div class="card p-3 mb-3">
        <div class="d-flex gap-3 flex-wrap align-items-center">
            <span class="badge-state st-unpaid">未付 @countUnpaid</span>
            <span class="badge-state st-partial">部分已付 @countPartial</span>
            <span class="badge-state st-paid">已结清 @countPaid</span>
            <span class="badge-state st-overdue">已逾期 @countOverdue</span>
            <span class="section-hint ms-auto">含自动出账与人工补录账单</span>
        </div>
        <div class="mt-2 pt-2 border-top d-flex gap-3 flex-wrap align-items-baseline">
            <span class="fw-semibold">补录账单 @countManual 张：</span>
            <span>应收 <b>¥@manualTotal.ToString("0.00")</b></span>
            <span>已收 <b class="text-success">¥@manualPaid.ToString("0.00")</b></span>
            <span>未收 <b class="text-danger">¥@manualDue.ToString("0.00")</b></span>
            <span class="section-hint">人工补录的历史欠款，已计入上方应收 / 已收 / 未收合计</span>
        </div>
    </div>

    <h5 class="mt-2 mb-2">按账期月份</h5>
    @if (MonthYearBlocks.Count == 0)
    {
        <div class="card p-3 mb-3 empty no-label">当前筛选下没有账单。</div>
    }
    @foreach (var block in MonthYearBlocks)
    {
        <div class="card mb-3 year-block">
            <div class="year-block-header d-flex flex-wrap align-items-baseline gap-3">
                <span class="year-block-title">@block.Year 年</span>
                <span class="year-block-meta">
                    @block.Count 张账单 ·
                    应收 <b>¥@block.Total.ToString("0.00")</b> ·
                    已收 <b class="text-success">¥@block.Paid.ToString("0.00")</b> ·
                    未收 <b class="text-danger">¥@block.Due.ToString("0.00")</b> ·
                    收款率 @RateOf(block.Total, block.Paid)
                </span>
            </div>
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr><th>月份</th><th class="num">账单数</th><th class="num">应收</th><th class="num">已收</th><th class="num">未收</th><th class="num">收款率</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in block.Months)
                        {
                            <tr>
                                <td data-label="月份" class="fw-semibold">@m.Month.ToString("00") 月</td>
                                <td data-label="账单数" class="num">@(m.Count > 0 ? m.Count.ToString() : "—")</td>
                                <td data-label="应收" class="num">¥@m.Total.ToString("0.00")</td>
                                <td data-label="已收" class="num">¥@m.Paid.ToString("0.00")</td>
                                <td data-label="未收" class="num @(m.Total - m.Paid > 0 ? "text-danger" : "")">¥@((m.Total - m.Paid).ToString("0.00"))</td>
                                <td data-label="收款率" class="num">@RateOf(m.Total, m.Paid)</td>
                            </tr>
                        }
                        <tr>
                            <td data-label="月份" class="fw-bold">@block.Year 年合计</td>
                            <td data-label="账单数" class="num fw-bold">@block.Count</td>
                            <td data-label="应收" class="num fw-bold">¥@block.Total.ToString("0.00")</td>
                            <td data-label="已收" class="num fw-bold">¥@block.Paid.ToString("0.00")</td>
                            <td data-label="未收" class="num fw-bold text-danger">¥@block.Due.ToString("0.00")</td>
                            <td data-label="收款率" class="num fw-bold">@RateOf(block.Total, block.Paid)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

    <h5 class="mt-2 mb-2">按物业</h5>
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th>物业</th><th class="num">账单数</th><th class="num">应收</th><th class="num">已收</th><th class="num">未收</th><th class="num">收款率</th></tr>
            </thead>
            <tbody>
                @if (ByProperty.Count == 0)
                {
                    <tr><td colspan="6" class="empty no-label">没有数据</td></tr>
                }
                @foreach (var p in ByProperty)
                {
                    <tr>
                        <td data-label="物业" class="fw-semibold">@p.Name</td>
                        <td data-label="账单数" class="num">@p.Count</td>
                        <td data-label="应收" class="num">¥@p.Total.ToString("0.00")</td>
                        <td data-label="已收" class="num">¥@p.Paid.ToString("0.00")</td>
                        <td data-label="未收" class="num @(p.Total - p.Paid > 0 ? "text-danger" : "")">¥@((p.Total - p.Paid).ToString("0.00"))</td>
                        <td data-label="收款率" class="num">@RateOf(p.Total, p.Paid)</td>
                    </tr>
                }
                @if (ByProperty.Count > 0)
                {
                    <tr>
                        <td data-label="物业" class="fw-bold">合计</td>
                        <td data-label="账单数" class="num fw-bold">@scoped.Count()</td>
                        <td data-label="应收" class="num fw-bold">¥@sumTotal.ToString("0.00")</td>
                        <td data-label="已收" class="num fw-bold">¥@sumPaid.ToString("0.00")</td>
                        <td data-label="未收" class="num fw-bold text-danger">¥@sumDue.ToString("0.00")</td>
                        <td data-label="收款率" class="num fw-bold">@Rate</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h5 class="mt-3 mb-2">欠款一览</h5>
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th>物业 · 房间</th><th>租客</th><th>账期</th><th>到期日</th><th class="num">应收</th><th class="num">已收</th><th class="num">未收</th><th class="num">逾期</th></tr>
            </thead>
            <tbody>
                @if (Arrears.Count == 0)
                {
                    <tr><td colspan="8" class="empty no-label">没有欠款，账已全部收清。</td></tr>
                }
                @foreach (var b in Arrears)
                {
                    <tr>
                        <td data-label="物业 · 房间">
                            <div class="fw-semibold">@b.Room?.Name</div>
                            <div class="section-hint">@b.Room?.Property?.Name</div>
                        </td>
                        <td data-label="租客">@b.Tenant?.Name</td>
                        <td data-label="账期">
                            <div>@b.PeriodStart.ToString("yyyy-MM")</div>
                            @if (b.PeriodEnd.Year != b.PeriodStart.Year || b.PeriodEnd.Month != b.PeriodStart.Month)
                            {
                                <div class="section-hint">至 @b.PeriodEnd.ToString("yyyy-MM")</div>
                            }
                        </td>
                        <td data-label="到期日">@b.DueDate.ToString("yyyy-MM-dd")</td>
                        <td data-label="应收" class="num">¥@b.TotalAmount.ToString("0.00")</td>
                        <td data-label="已收" class="num">¥@b.PaidAmount.ToString("0.00")</td>
                        <td data-label="未收" class="num text-danger fw-semibold">¥@((b.TotalAmount - b.PaidAmount).ToString("0.00"))</td>
                        <td data-label="逾期" class="num @(b.IsOverdue(today) ? "text-danger" : "")">
                            @(b.IsOverdue(today) ? $"逾期 {(today - b.DueDate).Days} 天" : "未到期")
                        </td>
                    </tr>
                }
                @if (Arrears.Count > 0)
                {
                    <tr>
                        <td data-label="物业 · 房间" class="fw-bold" colspan="2">合计（@Arrears.Count 张）</td>
                        <td data-label="账期"></td>
                        <td data-label="到期日"></td>
                        <td data-label="应收" class="num fw-bold">¥@arTotal.ToString("0.00")</td>
                        <td data-label="已收" class="num fw-bold">¥@arPaid.ToString("0.00")</td>
                        <td data-label="未收" class="num fw-bold text-danger">¥@arDue.ToString("0.00")</td>
                        <td data-label="逾期"></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="section-hint mt-1">当前全部未收清的账单（不受年份筛选影响），含整月欠款与部分收款余欠，可用于催租核对。</div>
}

@code {
    private List<Bill> all = new();
    private int yearFilter;
    private DateTime today = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        all = await Db.Bills
            .Include(b => b.Room).ThenInclude(r => r!.Property)
            .Include(b => b.Tenant)
            .AsNoTracking()
            .ToListAsync();
    }

    private List<int> years => all.Select(b => b.PeriodStart.Year).Distinct().OrderByDescending(y => y).ToList();

    private IEnumerable<Bill> scoped => yearFilter == 0 ? all : all.Where(b => b.PeriodStart.Year == yearFilter);

    private decimal sumTotal => scoped.Sum(b => b.TotalAmount);
    private decimal sumPaid => scoped.Sum(b => b.PaidAmount);
    private decimal sumDue => sumTotal - sumPaid;
    private string Rate => sumTotal <= 0 ? "—" : (sumPaid / sumTotal * 100m).ToString("0.0") + "%";

    private static string RateOf(decimal total, decimal paid)
        => total <= 0 ? "—" : (paid / total * 100m).ToString("0.0") + "%";

    private int countUnpaid => scoped.Count(b => b.Status == BillStatus.Unpaid && !b.IsOverdue(today));
    private int countPartial => scoped.Count(b => b.Status == BillStatus.Partial);
    private int countPaid => scoped.Count(b => b.Status == BillStatus.Paid);
    private int countOverdue => scoped.Count(b => b.IsOverdue(today));

    // 补录账单小计（跟随年份筛选）
    private int countManual => scoped.Count(b => b.IsManual);
    private decimal manualTotal => scoped.Where(b => b.IsManual).Sum(b => b.TotalAmount);
    private decimal manualPaid => scoped.Where(b => b.IsManual).Sum(b => b.PaidAmount);
    private decimal manualDue => manualTotal - manualPaid;

    private sealed record MonthRow(int Year, int Month, int Count, decimal Total, decimal Paid);

    // ── 按年份划块：每个年份一个独立块，含 12 个自然月 + 该年合计 ──
    private sealed record YearBlock(int Year, List<MonthRow> Months, int Count, decimal Total, decimal Paid)
    {
        public decimal Due => Total - Paid;
    }

    private Dictionary<(int Year, int Month), MonthRow> monthLookup => all
        .GroupBy(b => (b.PeriodStart.Year, b.PeriodStart.Month))
        .ToDictionary(
            g => g.Key,
            g => new MonthRow(g.Key.Year, g.Key.Month, g.Count(), g.Sum(b => b.TotalAmount), g.Sum(b => b.PaidAmount)));

    /// <summary>年份块列表：跟随顶部年份筛选，全部年份时所有年份倒序展示。</summary>
    private List<YearBlock> MonthYearBlocks => scoped
        .Select(b => b.PeriodStart.Year)
        .Distinct()
        .OrderByDescending(y => y)
        .Select(y =>
        {
            var months = Enumerable.Range(1, 12)
                .Select(m => monthLookup.GetValueOrDefault((y, m)) ?? new MonthRow(y, m, 0, 0m, 0m))
                .ToList();
            return new YearBlock(y, months, months.Sum(r => r.Count), months.Sum(r => r.Total), months.Sum(r => r.Paid));
        })
        .ToList();

    private sealed record PropRow(string Name, int Count, decimal Total, decimal Paid);

    private List<PropRow> ByProperty => scoped
        .GroupBy(b => b.Room?.PropertyId ?? 0)
        .Select(g => new PropRow(
            g.First().Room?.Property?.Name ?? "未知物业",
            g.Count(), g.Sum(b => b.TotalAmount), g.Sum(b => b.PaidAmount)))
        .OrderByDescending(r => r.Total)
        .ToList();

    // ── 欠款一览：当前全部未收清的账单（不受年份筛选影响），按租客分组排序 ──
    private List<Bill> Arrears => all
        .Where(b => b.TotalAmount - b.PaidAmount > 0.001m)
        .OrderBy(b => b.Tenant?.Name).ThenBy(b => b.PeriodStart)
        .ToList();

    private decimal arTotal => Arrears.Sum(b => b.TotalAmount);
    private decimal arPaid => Arrears.Sum(b => b.PaidAmount);
    private decimal arDue => arTotal - arPaid;
}
