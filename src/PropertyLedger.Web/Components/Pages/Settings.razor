@page "/settings"
@attribute [Authorize(Policy = "Feature:settings")]
@rendermode InteractiveServer
@inject SettingsService SettingsSvc
@implements IDisposable

<PageTitle>设置</PageTitle>

<div class="page-head"><h1>设置</h1></div>

@if (Error is not null) { <div class="alert alert-danger py-2 px-3">@Error</div> }
@if (Ok is not null) { <div class="alert alert-success py-2 px-3">@Ok</div> }

<div class="card p-4 mb-3" id="update">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0">软件更新</h5>
        <span class="badge-state st-neutral">当前版本 v@(AppVersion.Current)</span>
    </div>
    <div class="section-hint mt-1 mb-3">
        检查 GitHub 仓库的最新 Release；发现新版本后可一键升级（自动拉取新镜像并重建容器，数据与设置不受影响）。
    </div>

    @if (upgradePhase is "started" or "polling")
    {
        <div class="upgrade-progress">
            <div class="fw-semibold">⏳ 正在升级：拉取新镜像并重建 web 容器…</div>
            <div class="section-hint mt-1">
                容器会自动重启（通常 1–3 分钟），期间服务短暂不可用；恢复后本页将自动刷新。此页可以先关闭，不影响升级。
            </div>
        </div>
    }
    else
    {
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <button class="btn btn-brand" @onclick="CheckUpdate" disabled="@checking">
                @(checking ? "检查中…" : (updateResult is null ? "检查更新" : "重新检查"))
            </button>
            @if (updateResult is not null && !updateResult.HasUpdate)
            {
                <span class="fw-semibold" style="color:var(--ok)">已是最新版本 ✓</span>
            }
        </div>
    }

    @if (checkErr is not null)
    {
        <div class="alert alert-danger py-2 px-3 mt-2 mb-0">@checkErr</div>
    }

    @if (updateResult is not null && updateResult.HasUpdate && upgradePhase is not ("started" or "polling"))
    {
        <div class="update-found mt-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="fw-bold">发现新版本 v@(updateResult.LatestVersion)</span>
                    <span class="section-hint ms-2">
                        当前 v@(updateResult.CurrentVersion)@(updateResult.PublishedAt is null ? "" : " · 发布于 " + updateResult.PublishedAt.Value.ToString("yyyy-MM-dd"))
                    </span>
                </div>
                @if (updateResult.ReleaseUrl is not null)
                {
                    <a href="@updateResult.ReleaseUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">查看 Release ↗</a>
                }
            </div>
            @if (updateResult.ReleaseNotes is not null)
            {
                <pre class="update-notes">@updateResult.ReleaseNotes</pre>
            }

            @if (upgradePhase == "confirm")
            {
                <div class="upgrade-confirm">
                    <div class="fw-semibold mb-1">确认升级到 v@(updateResult.LatestVersion)？</div>
                    <div class="section-hint mb-2">
                        升级容器将自动拉取新镜像并重建 web 容器，期间服务短暂中断（约 1–3 分钟），数据库与上传图片数据不受影响。
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-danger" @onclick="StartUpgrade">开始升级</button>
                        <button class="btn btn-outline-secondary" @onclick="CancelUpgrade">取消</button>
                    </div>
                </div>
            }
            else if (upgradePhase == "done")
            {
                <div class="alert alert-success py-2 px-3 mt-2 mb-0">@(upgradeMsg ?? "升级完成。")</div>
            }
            else if (upgradePhase == "failed")
            {
                <div class="alert alert-danger py-2 px-3 mt-2 mb-2">@(upgradeMsg ?? "升级未完成。")</div>
                <ManualUpgradeCmd />
            }
            else if (canAuto)
            {
                <div class="mt-2"><button class="btn btn-brand" @onclick="AskUpgrade">一键升级</button></div>
            }
            else
            {
                <div class="alert alert-warning py-2 px-3 mt-2 mb-2">
                    当前部署未挂载 docker.sock（或非 Docker 部署），无法应用内一键升级；请在部署机上手动执行：
                </div>
                <ManualUpgradeCmd />
            }
        </div>
    }
</div>

<div class="card p-4 mb-3">
    <div class="mb-3">
        <label class="form-label">房东称呼 / 落款</label>
        <input class="form-control" @bind="landlord" placeholder="如：王女士 / 李先生" />
        <div class="section-hint">显示在账单图片顶部与落款。</div>
    </div>
    <div class="mb-3">
        <label class="form-label">收款提示语</label>
        <input class="form-control" @bind="notice" placeholder="如：请在到期日前支付，转账后请告知，谢谢～" />
        <div class="section-hint">显示在账单图片底部。</div>
    </div>
    <button class="btn btn-brand" @onclick="SaveText">保存基础信息</button>
</div>

<div class="card p-4">
    <label class="form-label">收款二维码</label>
    <div class="section-hint mb-2">
        上传你的「微信收款码」或「支付宝收款码」图片，将显示在账单图片上，租客长按或扫码即可付款。建议上传微信收款码（与“发微信账单”场景一致）。
    </div>

    @if (qrDataUri is not null)
    {
        <div class="mb-3">
            <img src="@qrDataUri" alt="收款码" style="width:180px;height:180px;object-fit:contain;border:1px solid var(--line);border-radius:12px" />
        </div>
    }

    <div class="d-flex gap-2 flex-wrap align-items-center">
        <InputFile OnChange="OnQrSelected" accept="image/*" />
        @if (qrDataUri is not null)
        {
            <button class="btn btn-outline-danger btn-sm" @onclick="RemoveQr">移除收款码</button>
        }
    </div>
    <div class="section-hint mt-2">支持 PNG / JPG，建议正方形，大小不超过 5MB。</div>
</div>

@if (isAdmin)
{
    <div class="card p-4 mt-3 danger-zone">
        <h5 class="text-danger mb-2">危险操作 · 清空业务数据（仅总管理员可见）</h5>
        <div class="section-hint mb-3">
            删除全部<b>物业、房间、租客、租约、账单、收款记录</b>以及备注中上传的图片，用于把台账重置给新一批物业使用。
            <b>登录账号与基础设置（房东称呼、收款提示语、收款码）会保留</b>；操作不可恢复，请先确认已有备份。
        </div>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label">请输入「清空」两字以确认</label>
                <input class="form-control" @bind="wipeConfirmText" placeholder="清空" />
            </div>
            <div class="col-12 col-md-3">
                <button class="btn btn-danger" @onclick="WipeData" disabled="@(wipeConfirmText?.Trim() != "清空")">确认清空</button>
            </div>
        </div>
    </div>
}

@code {
    private string? landlord;
    private string? notice;
    private string? qrDataUri;
    private string? Error, Ok;
    private bool isAdmin;
    private string? wipeConfirmText;

    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private MaintenanceService Maintenance { get; set; } = default!;
    [Inject] private Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env { get; set; } = default!;
    [Inject] private UpdateService Updates { get; set; } = default!;
    [Inject] private DockerUpgradeService Upgrader { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    // ── 软件更新 ──
    private UpdateCheckResult? updateResult;
    private bool checking;
    private string? checkErr;
    private bool canAuto;
    /// <summary>none=未开始 confirm=待确认 started=启动中 polling=浏览器轮询中 done=成功 failed=失败</summary>
    private string upgradePhase = "none";
    private string? upgradeMsg;
    private DotNetObjectReference<Settings>? upgradeWatchRef;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        isAdmin = auth.User.IsInRole("Admin");

        var s = await SettingsSvc.GetManyAsync(new[]
        {
            SettingKeys.LandlordName, SettingKeys.PaymentNotice, SettingKeys.PayQrCode,
        });
        landlord = s.GetValueOrDefault(SettingKeys.LandlordName) ?? "";
        notice = s.GetValueOrDefault(SettingKeys.PaymentNotice) ?? "";
        qrDataUri = s.GetValueOrDefault(SettingKeys.PayQrCode);

        canAuto = Upgrader.CanAutoUpgrade;
        // 有新鲜缓存就先展示，后台再刷新一次（首页/侧边栏已触发的检查可复用）
        var cached = Updates.PeekCached();
        if (cached is not null)
        {
            updateResult = cached;
            _ = RefreshUpdateAsync();
        }
    }

    private async Task RefreshUpdateAsync()
    {
        try
        {
            updateResult = await Updates.CheckAsync();
            checkErr = null;
        }
        catch (Exception ex)
        {
            checkErr = "检查更新失败：" + ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckUpdate()
    {
        checking = true;
        checkErr = null;
        StateHasChanged();
        try
        {
            updateResult = await Updates.CheckAsync(force: true);
        }
        catch (Exception ex)
        {
            checkErr = "检查更新失败：" + ex.Message;
        }
        finally
        {
            checking = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AskUpgrade()
    {
        upgradePhase = "confirm";
        upgradeMsg = null;
    }

    private void CancelUpgrade() => upgradePhase = "none";

    private async Task StartUpgrade()
    {
        upgradePhase = "started";
        upgradeMsg = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var (started, message) = await Upgrader.StartUpgradeAsync();
            if (started)
            {
                upgradePhase = "polling";
                upgradeWatchRef?.Dispose();
                upgradeWatchRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("updateWatcher.start", updateResult?.LatestVersion ?? AppVersion.Current, upgradeWatchRef);
            }
            else
            {
                upgradePhase = "failed";
                upgradeMsg = message;
            }
        }
        catch (Exception ex)
        {
            upgradePhase = "failed";
            upgradeMsg = "启动升级失败：" + ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnUpgradeSucceeded(string version)
    {
        upgradePhase = "done";
        upgradeMsg = $"已成功升级到 v{version}，页面即将自动刷新。";
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnUpgradeTimeout()
    {
        upgradePhase = "failed";
        upgradeMsg = "等待超时：升级容器可能被网络卡在拉取镜像上。可稍后在部署机执行 docker logs propertyledger-upgrader 查看进度，或直接手动执行下方命令。";
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => upgradeWatchRef?.Dispose();

    private async Task WipeData()
    {
        Error = Ok = null;
        if (wipeConfirmText?.Trim() != "清空")
        {
            Error = "请先在输入框中输入「清空」两字确认。";
            return;
        }

        var (payments, items, bills, leases, rooms, tenants, properties) = await Maintenance.WipeBusinessDataAsync();

        // 清空富文本备注上传的图片（uploads 目录；Docker 中为挂载卷，保留目录本身）
        var files = 0;
        var uploadsDir = Path.Combine(Env.ContentRootPath, "uploads");
        if (Directory.Exists(uploadsDir))
        {
            foreach (var f in Directory.GetFiles(uploadsDir))
            {
                try { File.Delete(f); files++; } catch { /* 被占用的文件跳过 */ }
            }
        }

        wipeConfirmText = null;
        Ok = $"已清空业务数据：收款 {payments} 笔、杂费 {items} 条、账单 {bills} 张、租约 {leases} 份、房间 {rooms} 间、租客 {tenants} 位、物业 {properties} 处，并删除备注图片 {files} 个。登录账号与基础设置已保留。";
    }

    private async Task SaveText()
    {
        Error = Ok = null;
        await SettingsSvc.SetAsync(SettingKeys.LandlordName, landlord?.Trim());
        await SettingsSvc.SetAsync(SettingKeys.PaymentNotice, notice?.Trim());
        Ok = "已保存。";
    }

    private async Task OnQrSelected(InputFileChangeEventArgs e)
    {
        Error = Ok = null;
        var file = e.File;
        if (file is null) return;
        if (file.Size > 5 * 1024 * 1024) { Error = "图片不能超过 5MB。"; return; }

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var mime = file.ContentType;
            if (string.IsNullOrEmpty(mime) || !mime.StartsWith("image/")) mime = "image/png";
            qrDataUri = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            await SettingsSvc.SetAsync(SettingKeys.PayQrCode, qrDataUri);
            Ok = "收款码已保存，之后生成的账单图片会带上该二维码。";
        }
        catch (Exception ex)
        {
            Error = "上传失败：" + ex.Message;
        }
    }

    private async Task RemoveQr()
    {
        qrDataUri = null;
        await SettingsSvc.SetAsync(SettingKeys.PayQrCode, null);
        Ok = "收款码已移除。";
    }
}
