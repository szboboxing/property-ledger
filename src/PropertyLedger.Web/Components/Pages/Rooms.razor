@page "/rooms"
@rendermode InteractiveServer
@inject AppDbContext Db

<PageTitle>房间管理</PageTitle>

<div class="page-head">
    <h1>房间</h1>
</div>

@if (properties.Count == 0)
{
    <div class="card p-4 empty">请先到「物业」页添加物业，再来登记房间。</div>
}
else
{
    <div class="card p-3 mb-3">
        <strong class="d-block mb-2">@(editingId is null ? "新增房间" : "编辑房间")</strong>
        <div class="row g-2">
            <div class="col-6 col-md-3">
                <label class="form-label">所属物业 *</label>
                <select class="form-select" @bind="form.PropertyId">
                    @foreach (var p in properties)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">房号 / 名称 *</label>
                <input class="form-control" @bind="form.Name" placeholder="如 3栋502" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label">面积(㎡)</label>
                <input type="number" step="0.01" class="form-control" @bind="form.Area" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label">默认月租</label>
                <input type="number" step="0.01" class="form-control" @bind="form.DefaultRent" />
            </div>
            <div class="col-12 col-md-2 d-flex align-items-end gap-2">
                <button class="btn btn-brand" @onclick="Save">@(editingId is null ? "添加" : "保存")</button>
                @if (editingId is not null)
                {
                    <button class="btn btn-outline-secondary" @onclick="ResetForm">取消</button>
                }
            </div>
            <div class="col-12 col-md-8">
                <label class="form-label">备注</label>
                <input class="form-control" @bind="form.Note" placeholder="选填，如 朝南、带空调" />
            </div>
            @if (editingId is not null)
            {
                <div class="col-12 col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="archived" @bind="form.IsArchived" />
                        <label class="form-check-label" for="archived">归档（停用，保留历史）</label>
                    </div>
                </div>
            }
        </div>
        @if (Error is not null)
        {
            <div class="alert alert-danger py-2 px-3 mt-2 mb-0">@Error</div>
        }
    </div>

    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th>物业 / 房号</th><th class="num">面积</th><th class="num">默认月租</th><th>当前租客</th><th>备注</th><th class="num">操作</th></tr>
            </thead>
            <tbody>
                @if (rooms.Count == 0)
                {
                    <tr><td colspan="6" class="empty no-label">还没有房间</td></tr>
                }
                @foreach (var r in rooms)
                {
                    var lease = r.Leases.FirstOrDefault(l => l.Status == LeaseStatus.Active);
                    <tr style="@(r.IsArchived ? "opacity:.55" : null)">
                        <td data-label="物业/房号">
                            <div class="fw-semibold">@r.Name @if (r.IsArchived){<span class="badge-state st-neutral ms-1">已归档</span>}</div>
                            <div class="section-hint">@r.Property?.Name</div>
                        </td>
                        <td data-label="面积" class="num">@(r.Area.HasValue ? r.Area.Value.ToString("0.##") : "—")</td>
                        <td data-label="默认月租" class="num">¥@r.DefaultRent.ToString("0.00")</td>
                        <td data-label="当前租客">
                            @if (lease is not null)
                            {
                                <span class="text-brand">@(lease.Tenant?.Name ?? "租客#" + lease.TenantId)</span>
                            }
                            else
                            {
                                <span class="section-hint">空置</span>
                            }
                        </td>
                        <td data-label="备注">@(r.Note ?? "—")</td>
                        <td data-label="操作" class="num no-label">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(r)">编辑</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(r)">删除</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Property> properties = new();
    private List<Room> rooms = new();
    private int? editingId;
    private string? Error;
    private FormModel form = new();

    private class FormModel
    {
        public int PropertyId { get; set; }
        public string Name { get; set; } = "";
        public decimal? Area { get; set; }
        public decimal DefaultRent { get; set; }
        public string? Note { get; set; }
        public bool IsArchived { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        properties = await Db.Properties.OrderBy(p => p.Id).AsNoTracking().ToListAsync();
        if (properties.Count > 0) form.PropertyId = properties[0].Id;
        await LoadRoomsAsync();
    }

    private async Task LoadRoomsAsync()
    {
        rooms = await Db.Rooms
            .Include(r => r.Property)
            .Include(r => r.Leases).ThenInclude(l => l.Tenant)
            .OrderBy(r => r.PropertyId).ThenBy(r => r.Id)
            .AsNoTracking().ToListAsync();
    }

    private void Edit(Room r)
    {
        editingId = r.Id;
        form = new FormModel
        {
            PropertyId = r.PropertyId, Name = r.Name, Area = r.Area,
            DefaultRent = r.DefaultRent, Note = r.Note, IsArchived = r.IsArchived,
        };
        Error = null;
    }

    private void ResetForm()
    {
        editingId = null;
        form = new FormModel { PropertyId = properties.FirstOrDefault()?.Id ?? 0 };
        Error = null;
    }

    private async Task Save()
    {
        if (form.PropertyId <= 0) { Error = "请选择物业。"; return; }
        if (string.IsNullOrWhiteSpace(form.Name)) { Error = "请填写房号 / 名称。"; return; }

        if (editingId is null)
        {
            Db.Rooms.Add(new Room
            {
                PropertyId = form.PropertyId, Name = form.Name.Trim(), Area = form.Area,
                DefaultRent = form.DefaultRent, Note = form.Note,
            });
        }
        else
        {
            var r = await Db.Rooms.FindAsync(editingId);
            if (r is not null)
            {
                r.PropertyId = form.PropertyId;
                r.Name = form.Name.Trim();
                r.Area = form.Area;
                r.DefaultRent = form.DefaultRent;
                r.Note = form.Note;
                r.IsArchived = form.IsArchived;
            }
        }
        await Db.SaveChangesAsync();
        ResetForm();
        await LoadRoomsAsync();
    }

    private async Task Delete(Room r)
    {
        var leaseCount = await Db.Leases.CountAsync(l => l.RoomId == r.Id);
        if (leaseCount > 0)
        {
            Error = "该房间存在租约 / 账单历史，不能删除；可改为「归档」停用。";
            return;
        }
        var entity = await Db.Rooms.FindAsync(r.Id);
        if (entity is not null)
        {
            Db.Rooms.Remove(entity);
            await Db.SaveChangesAsync();
        }
        await LoadRoomsAsync();
    }
}
