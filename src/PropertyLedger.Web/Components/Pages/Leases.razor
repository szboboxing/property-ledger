@page "/leases"
@attribute [Authorize(Policy = "Feature:leases")]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject BillingService Billing

<PageTitle>租约管理</PageTitle>

<div class="page-head">
    <h1>租约</h1>
</div>

@if (rooms.Count == 0 || tenants.Count == 0)
{
    <div class="card p-4 empty">请先在「房间」和「租客」页登记基础信息，再来签订租约。</div>
}
else
{
    <div class="card p-3 mb-3">
        <strong class="d-block mb-2">@(editingId is null ? "签订新租约" : "编辑租约")</strong>
        <div class="row g-2">
            <div class="col-6 col-md-3">
                <label class="form-label">房间 *</label>
                <select class="form-select" @bind="form.RoomId">
                    @foreach (var r in rooms)
                    {
                        <option value="@r.Id">@r.Property?.Name · @r.Name @(r.IsArchived ? "(归档)" : "")</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">租客 *</label>
                <select class="form-select" @bind="form.TenantId">
                    @foreach (var t in tenants)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">起租日 *</label>
                <input type="date" class="form-control" @bind="form.StartDate" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">到期日</label>
                <input type="date" class="form-control" @bind="form.EndDate" disabled="@form.LongTerm" />
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="longterm" @bind="form.LongTerm" />
                    <label class="form-check-label" for="longterm">长期 / 不定期（不设到期日）</label>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">月租金 *</label>
                <input type="number" step="0.01" class="form-control" @bind="form.RentAmount" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">房屋押金</label>
                <input type="number" step="0.01" class="form-control" @bind="form.HouseDeposit" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">水电押金</label>
                <input type="number" step="0.01" class="form-control" @bind="form.UtilityDeposit" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">每月付租日</label>
                <input type="number" min="1" max="31" class="form-control" @bind="form.PaymentDay" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">付租周期</label>
                <select class="form-select" @bind="form.Cycle">
                    <option value="@PaymentCycle.Monthly">月付</option>
                    <option value="@PaymentCycle.Quarterly">季付（押一付三）</option>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">备注（支持富文本 / 上传图片）</label>
                <RichNoteEditor @bind-Value="form.Note" Placeholder="选填，如 含宽带、家电清单，可插入图片" Height="110" />
            </div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-brand" @onclick="Save">@(editingId is null ? "签订租约" : "保存")</button>
                @if (editingId is not null)
                {
                    <button class="btn btn-outline-secondary" @onclick="ResetForm">取消</button>
                }
            </div>
        </div>
        @if (Error is not null)
        {
            <div class="alert alert-danger py-2 px-3 mt-2 mb-0">@Error</div>
        }
    </div>

    @if (initLease is not null)
    {
        <div class="card p-3 mb-3">
            <div class="d-flex flex-wrap gap-2 align-items-baseline">
                <strong>历史账单初始化 — @initLease.Room?.Property?.Name · @initLease.Room?.Name · @initLease.Tenant?.Name</strong>
                <span class="section-hint">列出该租约起租至今未收清的账单：填写「收款日期 + 本次实收」提交即登记收款（日期留空默认按到期日）；留空金额保持未付（欠款留账）；部分收款直接填实际金额。</span>
            </div>
            <div class="table-wrap mt-2">
                <table class="data">
                    <thead>
                        <tr><th>账期</th><th>到期日</th><th class="num">应收</th><th class="num">已收</th><th class="num">剩余</th><th>收款日期</th><th class="num">本次实收</th><th>方式</th></tr>
                    </thead>
                    <tbody>
                        @if (initRows.Count == 0)
                        {
                            <tr><td colspan="8" class="empty no-label">该租约没有未收清的账单，无需初始化。</td></tr>
                        }
                        @foreach (var r in initRows)
                        {
                            <tr>
                                <td data-label="账期">
                                    <div class="fw-semibold">@r.Bill.PeriodStart.ToString("yyyy-MM")</div>
                                    @if (r.Bill.PeriodEnd.Year != r.Bill.PeriodStart.Year || r.Bill.PeriodEnd.Month != r.Bill.PeriodStart.Month)
                                    {
                                        <div class="section-hint">至 @r.Bill.PeriodEnd.ToString("yyyy-MM")</div>
                                    }
                                    @if (r.Bill.IsManual)
                                    {
                                        <span class="badge-state st-neutral">补录</span>
                                    }
                                </td>
                                <td data-label="到期日">@r.Bill.DueDate.ToString("yyyy-MM-dd")</td>
                                <td data-label="应收" class="num">¥@r.Bill.TotalAmount.ToString("0.00")</td>
                                <td data-label="已收" class="num">¥@r.Bill.PaidAmount.ToString("0.00")</td>
                                <td data-label="剩余" class="num text-danger fw-semibold">¥@r.Remaining.ToString("0.00")</td>
                                <td data-label="收款日期"><input type="date" class="form-control form-control-sm" @bind="r.PaidDate" /></td>
                                <td data-label="本次实收" class="num"><input type="number" step="0.01" min="0" class="form-control form-control-sm text-end" style="max-width:130px" @bind="r.Amount" placeholder='@r.Remaining.ToString("0.##")' /></td>
                                <td data-label="方式">
                                    <select class="form-select form-select-sm" @bind="r.Method">
                                        <option value="@PaymentMethod.WeChat">微信</option>
                                        <option value="@PaymentMethod.Alipay">支付宝</option>
                                        <option value="@PaymentMethod.Bank">银行转账</option>
                                        <option value="@PaymentMethod.Cash">现金</option>
                                        <option value="@PaymentMethod.Other">其他</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex gap-2 flex-wrap mt-2">
                <button class="btn btn-sm btn-outline-success" @onclick="FillAllInit" disabled="@(initRows.Count == 0)">全部按剩余收清</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearInitRows" disabled="@(initRows.Count == 0)">清空填写</button>
                <button class="btn btn-brand" @onclick="SubmitInit" disabled="@(initRows.Count == 0)">提交登记收款</button>
                <button class="btn btn-outline-secondary" @onclick="CloseInit">关闭</button>
            </div>
            @if (initErr is not null)
            {
                <div class="alert alert-danger py-2 px-3 mt-2 mb-0">@initErr</div>
            }
            @if (initOk is not null)
            {
                <div class="alert alert-success py-2 px-3 mt-2 mb-0">@initOk</div>
            }
        </div>
    }

    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th>房间</th><th>租客</th><th>租期</th><th class="num">月租</th><th class="num">押金（房屋/水电）</th><th>付租</th><th>状态</th><th class="num">操作</th></tr>
            </thead>
            <tbody>
                @if (leases.Count == 0)
                {
                    <tr><td colspan="8" class="empty no-label">还没有租约</td></tr>
                }
                @foreach (var l in leases)
                {
                    <tr style="@(l.Status == LeaseStatus.Ended ? "opacity:.6" : null)">
                        <td data-label="房间"><div class="fw-semibold">@l.Room?.Name</div><div class="section-hint">@l.Room?.Property?.Name</div></td>
                        <td data-label="租客">@l.Tenant?.Name</td>
                        <td data-label="租期">
                            <div>@l.StartDate.ToString("yyyy-MM-dd") 起</div>
                            <div class="section-hint">@(l.EndDate.HasValue ? "至 " + l.EndDate.Value.ToString("yyyy-MM-dd") : "长期")</div>
                        </td>
                        <td data-label="月租" class="num">¥@l.RentAmount.ToString("0.00")</td>
                        <td data-label="押金（房屋/水电）" class="num">
                            <div>¥@l.HouseDeposit.ToString("0.00")</div>
                            <div class="section-hint">水电 ¥@l.UtilityDeposit.ToString("0.00")</div>
                        </td>
                        <td data-label="付租">
                            @(l.PaymentCycle == PaymentCycle.Quarterly ? "季付" : "月付")
                            <div class="section-hint">每月 @l.PaymentDay 日</div>
                        </td>
                        <td data-label="状态">
                            @if (l.Status == LeaseStatus.Active)
                            {
                                @if (l.EndDate.HasValue && l.EndDate.Value < DateTime.Today.AddDays(30))
                                {
                                    <span class="badge-state st-partial">即将到期</span>
                                }
                                else
                                {
                                    <span class="badge-state st-paid">生效中</span>
                                }
                            }
                            else
                            {
                                <span class="badge-state st-neutral">已退租</span>
                            }
                        </td>
                        <td data-label="操作" class="num no-label">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(l)">编辑</button>
                            <button class="btn btn-sm btn-outline-info" title="把起租至今的历史账单按实际收款情况录平（已收/部分收/欠款）" @onclick="() => OpenInit(l)">初始化账单</button>
                            @if (l.Status == LeaseStatus.Active)
                            {
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => End(l)">退租</button>
                            }
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(l)">删除</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Room> rooms = new();
    private List<Tenant> tenants = new();
    private List<Lease> leases = new();
    private int? editingId;
    private string? Error;
    private FormModel form = new();

    private class FormModel
    {
        public int RoomId { get; set; }
        public int TenantId { get; set; }
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime? EndDate { get; set; }
        public bool LongTerm { get; set; } = true;
        public decimal RentAmount { get; set; }
        public decimal HouseDeposit { get; set; }
        public decimal UtilityDeposit { get; set; }
        public int PaymentDay { get; set; } = 1;
        public PaymentCycle Cycle { get; set; } = PaymentCycle.Monthly;
        public string? Note { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        rooms = await Db.Rooms.Include(r => r.Property).OrderBy(r => r.PropertyId).ThenBy(r => r.Id).AsNoTracking().ToListAsync();
        tenants = await Db.Tenants.OrderBy(t => t.Id).AsNoTracking().ToListAsync();
        await LoadLeasesAsync();
        var firstRoom = rooms.FirstOrDefault(r => !r.IsArchived) ?? rooms.FirstOrDefault();
        if (firstRoom is not null)
        {
            form.RoomId = firstRoom.Id;
            form.RentAmount = firstRoom.DefaultRent;
        }
        form.TenantId = tenants.FirstOrDefault()?.Id ?? 0;
    }

    private async Task LoadLeasesAsync()
    {
        leases = await Db.Leases
            .Include(l => l.Room).ThenInclude(r => r!.Property)
            .Include(l => l.Tenant)
            .OrderByDescending(l => l.Status).ThenByDescending(l => l.StartDate)
            .AsNoTracking().ToListAsync();
    }

    private void Edit(Lease l)
    {
        editingId = l.Id;
        form = new FormModel
        {
            RoomId = l.RoomId, TenantId = l.TenantId,
            StartDate = l.StartDate, EndDate = l.EndDate, LongTerm = !l.EndDate.HasValue,
            RentAmount = l.RentAmount, HouseDeposit = l.HouseDeposit, UtilityDeposit = l.UtilityDeposit, PaymentDay = l.PaymentDay,
            Cycle = l.PaymentCycle, Note = l.Note,
        };
        Error = null;
    }

    private void ResetForm()
    {
        editingId = null;
        var firstRoom = rooms.FirstOrDefault(r => !r.IsArchived) ?? rooms.FirstOrDefault();
        form = new FormModel
        {
            RoomId = firstRoom?.Id ?? 0,
            TenantId = tenants.FirstOrDefault()?.Id ?? 0,
            RentAmount = firstRoom?.DefaultRent ?? 0,
        };
        Error = null;
    }

    private async Task Save()
    {
        if (form.RoomId <= 0 || form.TenantId <= 0) { Error = "请选择房间和租客。"; return; }
        if (form.RentAmount < 0) { Error = "租金不能为负。"; return; }
        form.PaymentDay = Math.Clamp(form.PaymentDay, 1, 31);
        var end = form.LongTerm ? null : form.EndDate;
        if (end.HasValue && end.Value < form.StartDate) { Error = "到期日不能早于起租日。"; return; }

        if (editingId is null)
        {
            // 同一房间不允许两张生效租约
            var conflict = await Db.Leases.AnyAsync(l =>
                l.RoomId == form.RoomId && l.Status == LeaseStatus.Active);
            if (conflict) { Error = "该房间已有生效中的租约，请先对原租约办理退租。"; return; }

            Db.Leases.Add(new Lease
            {
                RoomId = form.RoomId, TenantId = form.TenantId,
                StartDate = form.StartDate, EndDate = end,
                RentAmount = form.RentAmount, HouseDeposit = form.HouseDeposit, UtilityDeposit = form.UtilityDeposit,
                PaymentDay = form.PaymentDay, PaymentCycle = form.Cycle, Note = form.Note,
                Status = LeaseStatus.Active,
            });
        }
        else
        {
            var l = await Db.Leases.FindAsync(editingId);
            if (l is not null)
            {
                l.RoomId = form.RoomId; l.TenantId = form.TenantId;
                l.StartDate = form.StartDate; l.EndDate = end;
                l.RentAmount = form.RentAmount; l.HouseDeposit = form.HouseDeposit; l.UtilityDeposit = form.UtilityDeposit;
                l.PaymentDay = form.PaymentDay; l.PaymentCycle = form.Cycle; l.Note = form.Note;
            }
        }
        await Db.SaveChangesAsync();
        ResetForm();
        await LoadLeasesAsync();
    }

    private async Task End(Lease l)
    {
        var entity = await Db.Leases.FindAsync(l.Id);
        if (entity is null) return;
        entity.Status = LeaseStatus.Ended;
        var today = DateTime.Today;
        if (!entity.EndDate.HasValue || entity.EndDate.Value > today) entity.EndDate = today;
        await Db.SaveChangesAsync();
        await LoadLeasesAsync();
    }

    private async Task Delete(Lease l)
    {
        var billCount = await Db.Bills.CountAsync(b => b.LeaseId == l.Id);
        if (billCount > 0)
        {
            Error = $"该租约已生成 {billCount} 张账单，不能删除；如已结束请点「退租」（历史账单会保留）。";
            return;
        }
        var entity = await Db.Leases.FindAsync(l.Id);
        if (entity is not null)
        {
            Db.Leases.Remove(entity);
            await Db.SaveChangesAsync();
        }
        await LoadLeasesAsync();
    }

    // ───────────────────── 历史账单初始化（录入历史租约时按实际收款情况把账录平）─────────────────────
    private Lease? initLease;
    private List<Bill> initBills = new();
    private List<InitRow> initRows = new();
    private string? initErr, initOk;

    private sealed class InitRow
    {
        public Bill Bill { get; set; } = default!;
        public decimal Remaining { get; set; }
        public DateTime? PaidDate { get; set; }
        public decimal? Amount { get; set; }
        public PaymentMethod Method { get; set; } = PaymentMethod.WeChat;
    }

    private async Task OpenInit(Lease l)
    {
        initLease = l;
        initErr = initOk = null;
        // 生效租约先补齐到当月的账单（幂等），确保历史月份都存在
        if (l.Status == LeaseStatus.Active)
            await Billing.EnsureBillsThroughAsync(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1));
        await ReloadInitAsync();
    }

    private async Task ReloadInitAsync()
    {
        if (initLease is null) return;
        var cutoff = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1); // 含当月
        var bills = await Db.Bills
            .Include(b => b.Payments)
            .Where(b => b.LeaseId == initLease.Id && b.PeriodStart < cutoff)
            .OrderBy(b => b.PeriodStart)
            .AsNoTracking()
            .ToListAsync();
        initBills = bills.Where(b => b.TotalAmount - b.PaidAmount > 0.001m).ToList();
        initRows = initBills.Select(b => new InitRow
        {
            Bill = b,
            Remaining = b.TotalAmount - b.PaidAmount,
            Method = PaymentMethod.WeChat,
        }).ToList();
    }

    private void FillAllInit()
    {
        foreach (var r in initRows)
        {
            r.Amount = r.Remaining;
            r.PaidDate = r.Bill.DueDate > DateTime.Today ? DateTime.Today : r.Bill.DueDate;
        }
        initErr = initOk = null;
    }

    private void ClearInitRows()
    {
        foreach (var r in initRows)
        {
            r.Amount = null;
            r.PaidDate = null;
        }
        initErr = initOk = null;
    }

    private void CloseInit()
    {
        initLease = null;
        initBills = new();
        initRows = new();
        initErr = initOk = null;
    }

    private async Task SubmitInit()
    {
        initErr = initOk = null;
        var jobs = new List<(InitRow Row, decimal Amount, DateTime PaidAt)>();
        foreach (var r in initRows)
        {
            var amt = r.Amount ?? 0m;
            if (amt <= 0m) continue;
            if (amt > r.Remaining + 0.001m)
            {
                initErr = $"「{r.Bill.PeriodStart:yyyy-MM}」本次实收 ¥{amt:0.00} 超过剩余应收 ¥{r.Remaining:0.00}，请修正后再提交。";
                return;
            }
            var date = r.PaidDate ?? (r.Bill.DueDate > DateTime.Today ? DateTime.Today : r.Bill.DueDate);
            jobs.Add((r, amt, date));
        }
        if (jobs.Count == 0)
        {
            initErr = "请至少为一行填写「本次实收」金额（留空的月份保持未付欠款）。";
            return;
        }

        decimal total = 0m;
        try
        {
            foreach (var (row, amt, date) in jobs)
            {
                await Billing.RecordPaymentAsync(row.Bill.Id, amt, row.Method, date, "录入初始化");
                total += amt;
            }
        }
        catch (DomainException ex)
        {
            initErr = ex.Message + "（前面的收款已登记成功，请修正该行后重新提交剩余部分。）";
            await ReloadInitAsync();
            return;
        }

        var leftUnpaid = initRows.Count - jobs.Count;
        initOk = $"已登记 {jobs.Count} 笔收款，合计 ¥{total:0.00}；{leftUnpaid} 张账单保持未付（欠款留账，可在报表「欠款一览」查看）。";
        await ReloadInitAsync();
    }
}
