@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        @* 外壳：桌面常驻侧边栏；手机抽屉（checkbox hack，纯 CSS 展开收起） *@
        <div class="app-shell">
            <input type="checkbox" id="nav-toggle" class="nav-toggle" />

            <aside class="app-sidebar">
                <div class="sidebar-brand"><span class="ico">🏠</span>物业管理小工具</div>
                <nav class="sidebar-nav">
                    <NavMenuLinks User="context.User" />
                </nav>
                <div class="sidebar-foot">
                    <div class="sidebar-user">
                        <div class="name">@context.User.Identity?.Name</div>
                        <div class="role">@(context.User.IsInRole("Admin") ? "总管理员" : "普通用户")</div>
                    </div>
                    <a class="sidebar-logout" href="/logout">退出登录</a>
                </div>
            </aside>

            <label for="nav-toggle" class="nav-backdrop" aria-label="关闭菜单"></label>

            <div class="app-body">
                <header class="app-topbar">
                    <label for="nav-toggle" class="burger" aria-label="打开菜单">☰</label>
                    <span class="title">物业管理小工具</span>
                </header>

                <main class="app-main">
                    <div class="app-container">
                        @Body
                    </div>
                </main>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <main class="app-main">
            <div class="app-container">
                @Body
            </div>
        </main>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    发生了错误。<a href="." class="reload">重新加载</a>
    <span class="dismiss">🗙</span>
</div>
